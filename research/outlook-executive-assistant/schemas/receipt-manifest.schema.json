{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/receipt-manifest.schema.json",
  "title": "Weekly Outlook receipt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "range",
    "created_at",
    "stats",
    "documents",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "status": {
      "enum": ["success", "partial", "failed"]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "package_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages_scanned",
        "saved",
        "duplicates",
        "candidates",
        "rejected",
        "errors"
      ],
      "properties": {
        "messages_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "saved": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "totals_by_currency": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "source_kind",
        "received_at",
        "sender_address",
        "classification",
        "mime_type",
        "size_bytes",
        "sha256",
        "archive_path",
        "confidence",
        "review_reasons"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": ["attachment", "html_email"]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "sender_address": {
          "type": "string",
          "format": "email"
        },
        "classification": {
          "enum": [
            "paid_receipt",
            "invoice_unpaid",
            "refund",
            "statement",
            "candidate",
            "rejected"
          ]
        },
        "merchant": {
          "type": ["string", "null"]
        },
        "document_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "amount": {
          "type": ["number", "null"]
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "card_alias": {
          "type": ["string", "null"]
        },
        "card_last4": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}$"
        },
        "mime_type": {
          "enum": ["application/pdf", "image/jpeg", "image/png", "message/rfc822"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archive_path": {
          "type": "string",
          "pattern": "^/srv/hermes-receipts/(originals|rendered|quarantine)/"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "message"],
      "properties": {
        "stage": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "resource_hash": {
          "type": "string"
        }
      }
    }
  }
}
