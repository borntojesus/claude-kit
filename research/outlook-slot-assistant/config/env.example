# /opt/assistant/.env
# Права 600, власник assistant. Копії значень тримати в менеджері паролів власника.
# У репозиторій цей файл із реальними значеннями не потрапляє ніколи.

# Microsoft Entra: із реєстрації застосунку (див. SETUP.md, розділ 1)
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_SCOPES=Mail.Read Calendars.Read

# Скринька власника, чий календар читаємо
OWNER_UPN=owner@example.com
OWNER_TZ=Europe/Kyiv

# Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_ALLOWED_IDS=111111111,222222222
TELEGRAM_GROUP_ID=-1001234567890

# Модель для розбору таймзон із вільного тексту
LLM_API_KEY=REPLACE_ME
LLM_MODEL=claude-sonnet-5

# Шляхи
STATE_DB=/opt/assistant/state/assistant.sqlite
CONFIG_DIR=/opt/assistant/config
